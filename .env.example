# Flui API - Environment Configuration

# ============================================
# Hybrid Architecture Feature Flags
# ============================================

# Enable/disable hybrid architecture (default: false for safety)
USE_HYBRID_ARCHITECTURE=false

# Enable MCP isolated sandboxes (requires USE_HYBRID_ARCHITECTURE=true)
MCP_SANDBOX_ENABLED=false

# Enable sandbox pooling for performance (requires MCP_SANDBOX_ENABLED=true)
SANDBOX_POOLING_ENABLED=false

# Rollout percentage (0-100) - controls what % of traffic uses new architecture
HYBRID_ROLLOUT_PERCENTAGE=0

# Comma-separated list of workflow IDs to enable hybrid architecture for
# Example: HYBRID_ENABLED_WORKFLOWS=workflow-abc,workflow-def
HYBRID_ENABLED_WORKFLOWS=

# Comma-separated list of MCP IDs to enable sandboxing for
# Example: HYBRID_ENABLED_MCPS=mcp-1,mcp-2
HYBRID_ENABLED_MCPS=

# ============================================
# Sandbox Configuration
# ============================================

# Sandbox pool settings
SANDBOX_POOL_MIN_SIZE=0
SANDBOX_POOL_MAX_SIZE=10
SANDBOX_IDLE_TIMEOUT=300000

# Sandbox resource limits
SANDBOX_MAX_CPU=100
SANDBOX_MAX_MEMORY=512
SANDBOX_MAX_DISK=1024
SANDBOX_MAX_EXECUTION_TIME=30000
SANDBOX_NETWORK_ACCESS=restricted

# ============================================
# Resilience Configuration
# ============================================

# Retry policy
RETRY_MAX_RETRIES=2
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=10000
RETRY_BACKOFF_MULTIPLIER=2

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ============================================
# Observability
# ============================================

# Enable debug logging
DEBUG=false

# Metrics retention
METRICS_MAX_STORED=10000
LOGS_MAX_STORED=10000
METRICS_RETENTION_HOURS=24

# ============================================
# LLM Configuration (existing)
# ============================================

# LLM API endpoint
LLM_ENDPOINT=https://api.llm7.io/v1

# LLM API key (set via environment or secrets manager)
LLM_API_KEY=

# Default model
LLM_MODEL=gpt-4-turbo-preview

# Temperature
LLM_TEMPERATURE=0.7

# Max tokens
LLM_MAX_TOKENS=2000

# ============================================
# API Configuration (existing)
# ============================================

# API port
PORT=3001

# CORS origin
CORS_ORIGIN=*

# Node environment
NODE_ENV=production
