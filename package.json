{
  "name": "flui-api",
  "version": "1.0.0",
  "description": "Flui - API Backend para automação com agentes inteligentes e MCP",
  "type": "module",
  "scripts": {
    "dev": "tsx watch source/startApi.ts",
    "build": "tsc",
    "start": "node dist/startApi.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint source/**/*.ts",
    "format": "prettier --write source/**/*.ts"
  },
  "keywords": [
    "api",
    "automation",
    "agents",
    "ai",
    "mcp",
    "workflow",
    "backend"
  ],
  "author": "Flui Team",
  "license": "MIT",
  "dependencies": {
    "conf": "^12.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "minimatch": "^10.0.3",
    "nanoid": "^5.0.4",
    "node-cron": "^4.2.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
